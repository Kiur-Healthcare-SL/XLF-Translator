{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/git-write-guard/guard.py\" --claude",
            "timeout": 10,
            "statusMessage": "Checking for git write operations..."
          }
        ]
      }
    ]
  }
}
